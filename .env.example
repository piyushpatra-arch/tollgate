# Copy to .env and adjust. Never commit .env.
# Where the gateway container reaches Ollama (default: Ollama running on your host).
OLLAMA_API_BASE=http://host.docker.internal:11434
GRAFANA_ADMIN_PASSWORD=admin

# Used by the demo agent / evals running on your host:
TOLLGATE_URL=http://localhost:8080
TOLLGATE_KEY=tg-dev-kyc-review
