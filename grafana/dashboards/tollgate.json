    {
      "id": 11,
      "type": "table",
      "title": "Month-to-date spend by team and app (ledger \u2014 system of record)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT team, app, model_tier, count(*) AS calls,\n       sum(prompt_tokens + completion_tokens) AS tokens,\n       round(sum(shadow_cost_usd + actual_cost_usd)::numeric, 4) AS cost_usd\nFROM cost_ledger\nWHERE ts::timestamptz >= date_trunc('month', now())\nGROUP BY team, app, model_tier\nORDER BY cost_usd DESC;"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 12,
      "type": "table",
      "title": "Latest audit records",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT ts, app, task, outcome, status_code, model_tiers, policy_reasons, left(record_hash, 12) AS hash\nFROM audit_log\nORDER BY id DESC\nLIMIT 25;"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    }
